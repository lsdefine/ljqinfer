+    def test_dflash_append_normalizes_shared_hidden_once(self):
+        import ast
+        tree = ast.parse(Path("model/dflash2.py").read_text())
+        methods = {node.name: node for node in ast.walk(tree)
+                   if isinstance(node, ast.FunctionDef) and node.name in (
+                       "_project_normalized_kv", "append_context", "_append_graph_forward")}
+        self.assertEqual(len(methods), 3)
+        for name in ("append_context", "_append_graph_forward"):
+            method = methods[name]
+            norms = [node for node in ast.walk(method)
+                     if isinstance(node, ast.Call) and isinstance(node.func, ast.Name)
+                     and node.func.id == "_rms"]
+            self.assertEqual(len(norms), 1)
+            loops = [node for node in method.body if isinstance(node, ast.For)]
+            self.assertEqual(len(loops), 1)
+            self.assertLess(norms[0].lineno, loops[0].lineno)
+            self.assertTrue(any(isinstance(node, ast.Call)
+                                and isinstance(node.func, ast.Attribute)
+                                and node.func.attr == "_project_normalized_kv"
+                                for node in ast.walk(loops[0])))
+        projection = methods["_project_normalized_kv"]
+        self.assertFalse(any(isinstance(node, ast.Attribute) and node.attr == "hidden_norm"
+                             for node in ast.walk(projection)))
+
