@@ -584,0 +585,23 @@
+    def tp4_ordered_sum(self, gathered, out):
+        """TP4 BF16 sum in exact ((rank0+rank1)+rank3)+rank2 order."""
+        torch = self._torch()
+        if not (out.device.type == "npu" and gathered.device == out.device
+                and gathered.dtype == out.dtype == torch.bfloat16
+                and out.ndim == 2 and out.shape[0] in (16, 24, 32)
+                and out.shape[1] == 5120
+                and gathered.numel() == 4 * out.numel()
+                and out.is_contiguous() and gathered.is_contiguous()):
+            raise ValueError("tp4_ordered_sum requires contiguous BF16 TP4 B2-B4 Q8 hidden")
+        fn = getattr(self, "_tp4_ordered_sum_fn", None)
+        if fn is None:
+            lib = ctypes.CDLL(str(Path(__file__).resolve().parent / "native" / "ljq_tp4_ordered_sum.so"))
+            fn = lib.tp4_ordered_sum_launch
+            fn.argtypes = [ctypes.c_void_p] * 3 + [ctypes.c_uint32]
+            fn.restype = ctypes.c_int
+            self._tp4_ordered_sum_fn = fn
+        rc = fn(torch.npu.current_stream(out.device)._as_parameter_,
+                ctypes.c_void_p(gathered.data_ptr()), ctypes.c_void_p(out.data_ptr()), out.numel())
+        if rc != 0:
+            raise RuntimeError(f"tp4_ordered_sum launch failed: {rc}")
+        return out
+
